# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Frontend origin(s), comma separated. Used for CORS, cookies and links in emails.
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for locally stored upload URLs).
PUBLIC_API_URL=http://localhost:5000
SOCKET_CORS_ORIGIN=http://localhost:5173
# Set to 1 behind a proxy/load balancer (Render, Nginx, Docker compose).
TRUST_PROXY=
LOG_LEVEL=info
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=20

# ---------- Database ----------
# Local, Atlas (mongodb+srv://...), or a replica set (enables transactions).
MONGODB_URI=mongodb://127.0.0.1:27017/scrapmate

# ---------- Auth ----------
# Production requires a long random secret (32+ chars).
JWT_SECRET=change_this_dev_secret_key
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30
COOKIE_NAME=scrapmate_token
# 'lax' when frontend and API share a site; 'none' (with HTTPS) when they don't.
COOKIE_SAMESITE=lax

# ---------- AI chat assistant (optional: rule-based bot without a key) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (Claude API only). "off" for other platforms/models.
ANTHROPIC_FALLBACKS=default
CHAT_RATE_LIMIT_PER_MIN=12

# ---------- Support / WhatsApp (admins can override in Site settings) ----------
SUPPORT_WHATSAPP_NUMBER=
SUPPORT_HOURS_START=9
SUPPORT_HOURS_END=20
SUPPORT_TIMEZONE=Asia/Kolkata
SUPPORT_REPLY_MINUTES=10
DEFAULT_CITY=Bengaluru
# WhatsApp Cloud API for outgoing notifications (logs to console when missing)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---------- SMS / OTP (console OTP when missing) ----------
# 'twilio' or 'msg91'
SMS_PROVIDER=
SMS_PROVIDER_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Email (console when missing) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Payments (mock orders/payouts when missing) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX account number enables real UPI/bank payouts to customers.
RAZORPAYX_ACCOUNT_NUMBER=

# ---------- Images (saved under ./uploads when missing) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Maps (OpenStreetMap / Nominatim when missing) ----------
MAPS_API_KEY=

# ---------- Web push (in-app/email/WhatsApp still work without it) ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@scrapmate.dev
